; Always install the build toolchain (@angular/cli, build-angular, typescript are devDependencies).
; Colossus pipeline pods bake NODE_ENV=production, which makes npm default to omit=dev and leaves
; `ng` missing after an exit-0 install; `include` overrides `omit` per npm docs, so this keeps
; every install of a scaffolded frontend identical regardless of the caller's environment.
include=dev
legacy-peer-deps=true
